(app) {
	@api path /api /api/*

	handle @api {
		reverse_proxy {$BACKEND_HOST} {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}

			flush_interval -1

			transport http {
				versions 1.1
				read_timeout 3600s
			}
		}
	}

	handle {
		root * /usr/share/nginx/html
		try_files {path} {path}/ /index.html
		file_server {
			index index.html
		}
	}
}

:80 {
	import app
}
{
	default_sni {$SITE_HOST}
}
https://{$SITE_HOST}:443, https://${SiTE_HOST_ALT}:443 {
	tls internal
	import app
}